{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.schema.json",
  "name": "TalosCluster",
  "image": "oci.trueforge.org/containerforge/devcontainer:4.1.1@sha256:c09681a3fd23850a166f7c8a0d1dc7a1fea042a925396ee2df05858a9631973b",
  "initializeCommand": "mkdir -p ${localEnv:HOME}${localEnv:USERPROFILE}/.claude",
  "postCreateCommand": "if [ -f package.json ]; then npm install; fi",
  "postStartCommand": "git config --global --add safe.directory ${containerWorkspaceFolder}",
  "mounts": [
    "source=${localEnv:HOME}${localEnv:USERPROFILE}/.claude,target=/config/.claude,type=bind,consistency=cached",
    "source=talos-gh-config,target=/config/gh,type=volume",
    "source=talos-kube-config,target=/config/.kube,type=volume",
    "source=talos-fish-history,target=/config/.local/share/fish,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/config/.claude"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    },
    "ghcr.io/devcontainers/features/node:2": {
      "version": "26"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "albert.TabOut",
        "mikestead.dotenv",
        "mitchdenny.ecdc",
        "signageos.signageos-vscode-sops",
        "EditorConfig.editorconfig",
        "PKief.material-icon-theme",
        "usernamehw.errorlens",
        "redhat.vscode-yaml",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "sandipchitale.vscode-kubernetes-helm-extras",
        "eamodio.gitlens",
        "streetsidesoftware.code-spell-checker",
        "mhutchie.git-graph",
        "github.vscode-github-actions",
        "github.vscode-pull-request-github",
        "mkhl.direnv",
        "timonwong.shellcheck",
        "oderwat.indent-rainbow",
        "yzhang.markdown-all-in-one",
        "DavidAnson.vscode-markdownlint",
        "Anthropic.claude-code"
      ]
    }
  }
}
